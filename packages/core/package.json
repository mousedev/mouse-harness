{
  "name": "@mousedev/harness-core",
  "version": "0.1.0",
  "description": "The Mouse completion loop: probe the workspace, run its checks, scan for tampering, require a structured self-audit. Engine-agnostic, zero dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mousedev/mouse-harness.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mousedev/mouse-harness#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
