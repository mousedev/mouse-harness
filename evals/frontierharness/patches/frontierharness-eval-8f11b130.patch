+# Mouse run, 2026-09-07: reuse an existing runtime of this name rather than
+# fail; a create that returned before an earlier attempt died leaves one.
+if runta inspect "$RUNTIME" >/dev/null 2>&1; then
+  echo "reusing existing runtime $RUNTIME" >&2
+else
+  runta run --name "$RUNTIME" --cpus "$CPUS" --memory "$MEMORY" --disk-size-gib "$DISK_GIB"
+fi
+# Mouse run, 2026-09-07: `runta run` returns while the runtime is still being
+# created and exec fails until it is ready, so wait for it the way
+# run-trials.sh does for a restore.
+ready=0
+for _ in $(seq 1 60); do
+  if runta exec "$RUNTIME" -- sh -lc 'exit 0' >/dev/null 2>&1; then ready=1; break; fi
+  sleep 5
+done
+[ "$ready" -eq 1 ] || { echo "runtime $RUNTIME never became ready" >&2; exit 1; }
 
 if [ "$STORE_SECRET" -eq 1 ]; then
   step "2/9 storing $SECRET_NAME as a Runta secret stub ($PROVIDER)"
@@ -142,6 +157,14 @@ fi
 # The real value stays in the egress proxy; the runtime only ever sees the stub.
 rexec "test \"\$$SECRET_NAME\" = runta-secret-stub" \
   || echo "warning: $SECRET_NAME is not exposed as a stub inside the runtime" >&2
+# Mouse run, 2026-09-07: runta 0.2.0 does not expose the stub in the runtime's
+# environment on its own, and the agent needs *some* value in $SECRET_NAME to
+# consider the provider configured (the egress proxy rewrites the header with
+# the real key). A login-shell profile entry frozen into the checkpoint gives
+# every restored trial runtime the placeholder.
+rexec "printf 'export %s=runta-secret-stub\n' '$SECRET_NAME' > /etc/profile.d/fh-secret-stub.sh && chmod 644 /etc/profile.d/fh-secret-stub.sh"
+rexec "test \"\$$SECRET_NAME\" = runta-secret-stub" \
+  || { echo "$SECRET_NAME still not visible in a login shell; aborting" >&2; exit 1; }
 if [ -n "$PROVIDER_HOST" ]; then
   apply_provider_egress "$RUNTIME" "$PROVIDER_HOST" || true
 fi
@@ -270,6 +293,24 @@ jq -e . "./manifest-${CHECKPOINT}.json" >/dev/null \
 
 runta checkpoint create "$RUNTIME" "$CHECKPOINT"
 
+# Mouse run, 2026-09-07: on runta 0.2.0 `checkpoint create` returns while the
+# snapshot is still being taken (state "creating"), and deleting the source
+# runtime at that point aborted the checkpoint, which then vanished. Wait for
+# the checkpoint to leave "creating" before touching the runtime.
+state=creating
+for _ in $(seq 1 240); do
+  state=$(runta checkpoint ls --json 2>/dev/null \
+    | jq -r --arg n "$CHECKPOINT" '.checkpoints[] | select(.display_name == $n) | .state' 2>/dev/null)
+  [ -n "$state" ] || state=missing
+  [ "$state" = creating ] || break
+  sleep 15
+done
+echo "checkpoint $CHECKPOINT state: $state" >&2
+case "$state" in
+  creating) echo "checkpoint still creating after 60 minutes; leaving runtime $RUNTIME in place" >&2; exit 1 ;;
+  missing) echo "checkpoint disappeared while creating; leaving runtime $RUNTIME in place" >&2; exit 1 ;;
+esac
+
 if [ "$KEEP_RUNTIME" -eq 0 ]; then
   runta rm "$RUNTIME"
 fi
