diff --git a/skills/frontierharness-eval/scripts/providers.sh b/skills/frontierharness-eval/scripts/providers.sh
index 7c7fd55..924d83e 100644
--- a/skills/frontierharness-eval/scripts/providers.sh
+++ b/skills/frontierharness-eval/scripts/providers.sh
@@ -79,3 +79,16 @@ apply_provider_egress() {
   runta egress set "$runtime" --mode allowlist --allow "$host" \
     || { echo "warning: could not set egress allowlist on $runtime" >&2; return 1; }
 }
+
+# Mouse run, 2026-09-07: with runta 0.2.0 the allowlist above is enforced, and
+# it blocks apt, GitHub, PyPI, nodejs.org, npm, and the Docker registries that
+# the build (step 3 onwards) and the in-container agent install need, so
+# provisioning died at step 3. Egress stays open (denylist mode, no entries);
+# the provider key is still injected only for its host by the per-runtime
+# secret rule. Stated as a relaxation in the report.
+apply_provider_egress() {
+  local runtime=$1 host=$2
+  [ -n "$runtime" ] && [ -n "$host" ] || return 0
+  runta egress set "$runtime" --mode denylist \
+    || { echo "warning: could not set egress mode on $runtime" >&2; return 1; }
+}
diff --git a/skills/frontierharness-eval/scripts/provision-golden-checkpoint.sh b/skills/frontierharness-eval/scripts/provision-golden-checkpoint.sh
index 3bacf8f..890894a 100755
--- a/skills/frontierharness-eval/scripts/provision-golden-checkpoint.sh
+++ b/skills/frontierharness-eval/scripts/provision-golden-checkpoint.sh
@@ -131,7 +131,22 @@ step() { printf '\n=== %s\n' "$1" >&2; }
 rexec() { runta exec "$RUNTIME" -- sh -lc "$1"; }
 
 step "1/9 creating clean runtime $RUNTIME (${CPUS} vCPU, ${MEMORY} MiB, disk ${DISK_GIB} GiB)"
-runta run --name "$RUNTIME" --cpus "$CPUS" --memory "$MEMORY" --disk-size-gib "$DISK_GIB"
+# Mouse run, 2026-09-07: reuse an existing runtime of this name rather than
+# fail; a create that returned before an earlier attempt died leaves one.
+if runta inspect "$RUNTIME" >/dev/null 2>&1; then
+  echo "reusing existing runtime $RUNTIME" >&2
+else
+  runta run --name "$RUNTIME" --cpus "$CPUS" --memory "$MEMORY" --disk-size-gib "$DISK_GIB"
+fi
+# Mouse run, 2026-09-07: `runta run` returns while the runtime is still being
+# created and exec fails until it is ready, so wait for it the way
+# run-trials.sh does for a restore.
+ready=0
+for _ in $(seq 1 60); do
+  if runta exec "$RUNTIME" -- sh -lc 'exit 0' >/dev/null 2>&1; then ready=1; break; fi
+  sleep 5
+done
+[ "$ready" -eq 1 ] || { echo "runtime $RUNTIME never became ready" >&2; exit 1; }
 
 if [ "$STORE_SECRET" -eq 1 ]; then
   step "2/9 storing $SECRET_NAME as a Runta secret stub ($PROVIDER)"
@@ -142,6 +157,14 @@ fi
 # The real value stays in the egress proxy; the runtime only ever sees the stub.
 rexec "test \"\$$SECRET_NAME\" = runta-secret-stub" \
   || echo "warning: $SECRET_NAME is not exposed as a stub inside the runtime" >&2
+# Mouse run, 2026-09-07: runta 0.2.0 does not expose the stub in the runtime's
+# environment on its own, and the agent needs *some* value in $SECRET_NAME to
+# consider the provider configured (the egress proxy rewrites the header with
+# the real key). A login-shell profile entry frozen into the checkpoint gives
+# every restored trial runtime the placeholder.
+rexec "printf 'export %s=runta-secret-stub\n' '$SECRET_NAME' > /etc/profile.d/fh-secret-stub.sh && chmod 644 /etc/profile.d/fh-secret-stub.sh"
+rexec "test \"\$$SECRET_NAME\" = runta-secret-stub" \
+  || { echo "$SECRET_NAME still not visible in a login shell; aborting" >&2; exit 1; }
 if [ -n "$PROVIDER_HOST" ]; then
   apply_provider_egress "$RUNTIME" "$PROVIDER_HOST" || true
 fi
