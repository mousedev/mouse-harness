# Copy to evals/.env (gitignored). Load before a run:
#   set -a; source evals/.env; set +a
#
# Use a key created for benchmarking only, so its spend is visible on its own.
FIREWORKS_API_KEY=
# Optional fallback route (provider pinned to Fireworks in the bench config).
OPENROUTER_API_KEY=
# Optional: per-result tool output cap plugin.
# MOUSE_TOOL_OUTPUT_PRUNE=1
